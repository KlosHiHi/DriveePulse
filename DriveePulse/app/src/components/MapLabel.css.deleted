.map-label {
  position: absolute;
  pointer-events: none;
  left: 0;
  top: 0;
  transform-origin: center;
  opacity: 0;
  transition: opacity 0.2s ease-in-out;
  will-change: transform, opacity;
}

.map-label.visible {
  opacity: 1;
}

.map-label .label-text {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  color: var(--text-primary);
  background: var(--bg-surface);
  box-shadow: 0 2px 4px var(--shadow-color);
  border: 1px solid var(--border-color);
}

.map-label.primary .label-text {
  font-weight: 600;
  font-size: 13px;
}

.map-label.secondary .label-text {
  font-size: 11px;
  padding: 2px 6px;
}

[data-theme="dark"] .map-label .label-text {
  background: var(--bg-surface-dark);
}